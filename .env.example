# 主模型：选择一个支持图片理解与结构化 JSON 输出的服务
MODEL_API_TYPE=openai_compatible
MODEL_BASE_URL=https://YOUR_PROVIDER.example/v1
MODEL_API_KEY=
MODEL_NAME=YOUR_VISION_MODEL

# 按模型服务能力调整
MODEL_RESPONSE_FORMAT=json_schema
MODEL_STREAM=true
# MODEL_MAX_TOKENS_FIELD=max_tokens
# MODEL_COMPAT_MODE=qwen

# Gemini 原生接口示例：
# MODEL_API_TYPE=gemini
# MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# MODEL_API_KEY=
# MODEL_NAME=gemini-model-name

# 可选 OCR 坐标校准；不配置时不影响菜单识别、对话和点单
OCR_PROVIDER=none
# OCR_PROVIDER=qwen
# OCR_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# OCR_API_KEY=
# OCR_MODEL=qwen-vl-ocr

HOST=127.0.0.1
PORT=4173
# 公开部署时将目录挂载到持久化磁盘
# SESSION_DATA_DIR=/data
# SESSION_TTL_SECONDS=172800
# 匿名公开服务的成本与容量保护；按实际流量调整
# MODEL_REQUESTS_PER_WINDOW=60
# MODEL_REQUESTS_GLOBAL_PER_WINDOW=300
# RATE_LIMIT_WINDOW_SECONDS=3600
# SESSION_WRITES_PER_WINDOW=600
# SESSION_MAX_ACTIVE=500
# SESSION_MAX_STORED_IMAGE_BYTES=536870912
